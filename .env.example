# LaunchDarkly Demo Application - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# LaunchDarkly SDK Configuration
# ============================================================================

# LaunchDarkly SDK key (required for SDK initialization)
# To obtain an SDK key:
# 1. Log in to your LaunchDarkly account at https://app.launchdarkly.com
# 2. Navigate to Account Settings > Projects
# 3. Select your project and environment
# 4. Copy the SDK key from the "Server-side SDK" section
# 
# Example: sdk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LAUNCHDARKLY_SDK_KEY=

# LaunchDarkly Client-Side ID (required for JavaScript SDK in dashboard)
# To obtain a client-side ID:
# 1. Log in to your LaunchDarkly account at https://app.launchdarkly.com
# 2. Navigate to Account Settings > Projects
# 3. Select your project and environment
# 4. Copy the client-side ID from the "Client-side ID" section
# 
# Example: 6980ccadb17af909dd9c4abb
LAUNCHDARKLY_CLIENT_SIDE_ID=

# ============================================================================
# Relay Proxy Configuration
# ============================================================================

# URL of the LaunchDarkly Relay Proxy (default: http://relay-proxy:8030)
# When running with Docker Compose, use the service name: http://relay-proxy:8030
# For local development without Docker, use: http://localhost:8030
RELAY_PROXY_URL=http://relay-proxy:8030

# Relay Proxy Configuration Key (required for AutoConfig mode)
# To obtain a Relay Proxy configuration key:
# 1. Log in to your LaunchDarkly account at https://app.launchdarkly.com
# 2. Navigate to Account Settings > Relay Proxy
# 3. Create or copy your Relay Proxy configuration key
# 
# Example: rel-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RELAY_PROXY_CONFIG_KEY=

# ld-relay tag for the official launchdarkly/ld-relay image (default docker-compose.yml)
LD_RELAY_VERSION=9.0.0-rc.5

# Chainguard only — required for docker-compose-chainguard.yml (chainctl auth login)
# CHAINGUARD_ORG=your-org

# ============================================================================
# Service Port Configuration
# ============================================================================

# This section defines the external ports for all configurable services.
# You can customize these ports to avoid conflicts or run multiple instances.
# After changing ports, restart services with: docker-compose down && docker-compose up -d

# Dashboard Service Port (default: 8000)
# The web UI dashboard will be accessible at http://localhost:8000
# This is the main entry point for the demo application
DASHBOARD_PORT=8000

# API Service Port (default: 4000)
# The centralized API gateway service that coordinates backend services
# Accessible at http://localhost:4000
API_SERVICE_PORT=4000

# Node.js Service Port (default: 3000)
# The Node.js SDK demonstration service using Relay Proxy mode
# Accessible at http://localhost:3000
NODE_SERVICE_PORT=3000

# PHP Service Port (default: 8080)
# The PHP SDK demonstration service using Daemon Mode (Redis + Events)
# Accessible at http://localhost:8080
# Note: This maps to internal port 80 (Nginx)
PHP_SERVICE_PORT=8080

# Python Service Port (default: 5000)
# The Python SDK demonstration service
# Accessible at http://localhost:5000
PYTHON_SERVICE_PORT=5000

# Data System Service Port (default: 5001)
# Python SDK datasystem.custom() demo: Relay-first with LaunchDarkly fallback
# Accessible at http://localhost:5001
DATA_SYSTEM_PORT=5001

# Squid Proxy Service Port (default: 3128)
# HTTP proxy service for network traffic inspection
# Accessible at http://localhost:3128
SQUID_PROXY_PORT=3128

# ----------------------------------------------------------------------------
# Fixed Infrastructure Ports (DO NOT CHANGE)
# ----------------------------------------------------------------------------

# RELAY_PROXY_PORT: 8030 (FIXED)
# The LaunchDarkly Relay Proxy MUST run on port 8030 as required by the
# LaunchDarkly architecture. This port is hardcoded in docker-compose.yml
# and cannot be changed via environment variables.
# Internal URL: http://relay-proxy:8030

# REDIS_PORT: 6379 (FIXED)
# Redis MUST run on port 6379 as required by the LaunchDarkly Relay Proxy
# and PHP SDK daemon mode configuration. This port is hardcoded in
# docker-compose.yml and cannot be changed via environment variables because
# the LaunchDarkly Relay Proxy expects Redis on the standard port.
# Internal URL: redis://redis:6379

# ----------------------------------------------------------------------------
# Port Conflict Resolution
# ----------------------------------------------------------------------------

# If you encounter "port already in use" errors when starting services:
# 1. Identify which port is in conflict (check docker-compose error message)
# 2. Find the conflicting process using these troubleshooting commands:
#    - macOS/Linux: lsof -i :<port_number>
#    - Windows: netstat -ano | findstr :<port_number>
# 3. Either stop the conflicting process or change the port in this file
# 4. Restart services: docker-compose down && docker-compose up -d

# ----------------------------------------------------------------------------
# Custom Port Configuration Examples
# ----------------------------------------------------------------------------

# Example 1: Running multiple instances on the same machine
# This scenario is useful for testing or running different environments side-by-side.
# Instance 1 (default ports): Use values above
# Instance 2 (custom ports):
#   DASHBOARD_PORT=9000
#   API_SERVICE_PORT=9001
#   NODE_SERVICE_PORT=9002
#   PHP_SERVICE_PORT=9003
#   PYTHON_SERVICE_PORT=9004
#   SQUID_PROXY_PORT=9005

# Example 2: Avoiding common port conflicts
# If port 8000 conflicts with another service:
#   DASHBOARD_PORT=8888
# If port 3000 conflicts with another Node.js app:
#   NODE_SERVICE_PORT=3001

# Example 3: Using standard HTTP/HTTPS ports (requires sudo/admin)
#   DASHBOARD_PORT=80    # Standard HTTP
#   API_SERVICE_PORT=443 # Standard HTTPS (requires SSL configuration)

# ============================================================================
# Node.js Application Configuration (Relay Proxy Mode)
# ============================================================================

# The Node.js application uses Relay Proxy mode exclusively.
# All SDK traffic (streaming, flag evaluation, events) goes through the Relay Proxy.

# Port number for the Express web server (default: 3000)
# The application will listen on this port for HTTP requests
# This is set via NODE_SERVICE_PORT above
PORT=3000

# ============================================================================
# PHP Application Configuration (Daemon Mode: Redis + Events)
# ============================================================================

# The PHP application uses Daemon Mode exclusively.
# - Reads feature flags directly from Redis (high performance)
# - Sends analytics events through the Relay Proxy

# Redis Host for PHP SDK (default: redis)
# When running with Docker Compose, use the service name: redis
# For local development, use: localhost
REDIS_HOST=redis

# Redis Port for PHP SDK (fixed at 6379)
# See "Fixed Infrastructure Ports" section above for details
# Redis port cannot be changed via environment variables

# Redis Key Prefix (optional)
# The PHP SDK automatically determines the correct Redis prefix from the SDK key.
# However, you can explicitly set it to match the Relay Proxy's prefix format.
# The Relay Proxy uses: ld-flags-{ENVIRONMENT_ID}
# 
# To find your environment ID:
# 1. Run: docker exec redis redis-cli KEYS "*"
# 2. Look for keys like: ld-flags-507f1f77bcf86cd799439011:features
# 3. The environment ID is the part after "ld-flags-" and before the colon
#
# Example: REDIS_PREFIX=ld-flags-507f1f77bcf86cd799439011
# Required for PHP daemon mode. Relay Proxy stores flags as ld-flags-{client-side-id}:features
REDIS_PREFIX=

# ============================================================================
# Redis Configuration
# ============================================================================

# Redis is configured automatically in docker-compose.yml and requires no
# additional environment variables. The relay proxy is pre-configured to use
# Redis for persistent storage of feature flag data.
#
# Redis Configuration Details:
# - Redis runs on internal Docker network (not exposed to host by default)
# - Connection URL: redis://redis:6379 (internal hostname)
# - Data persistence: Enabled via Docker volume (redis-data)
# - No authentication required for internal Docker network
#
# For advanced Redis configuration, modify docker-compose.yml directly.
